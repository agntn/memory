{
  "name": "@agntn/memory",
  "version": "0.0.0",
  "description": "Unified interface for agent memory systems.",
  "keywords": [
    "agents",
    "cloudflare",
    "memory"
  ],
  "homepage": "https://github.com/agntn/memory#readme",
  "bugs": "https://github.com/agntn/memory/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/memory.git"
  },
  "bin": {
    "memory": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/shared",
    "extensions/pi",
    "extensions/omp"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "fmt": "pnpm build && vp lint --fix && vp fmt",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "lint:fix": "pnpm build && vp lint --fix && vp fmt",
    "typecheck": "pnpm build && tsc --noEmit --skipLibCheck && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vp test run",
    "test:packed": "node --import tsx test/eval-packed.mjs",
    "test:watch": "vp test watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agntn/credentials": "0.0.2",
    "@agntn/tools": "0.2.4",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@oh-my-pi/omptype": "18.0.5",
    "@oh-my-pi/pi-coding-agent": "18.0.5",
    "@oh-my-pi/pi-tui": "18.0.5",
    "@types/node": "26.2.0",
    "obuild": "0.4.40",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "@earendil-works/pi-tui": ">=0.84.2 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "@oh-my-pi/pi-tui": ">=18.0.0 <19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.22.0",
  "omp": {
    "extensions": [
      "./extensions/omp/memory.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/memory.ts"
    ]
  }
}
